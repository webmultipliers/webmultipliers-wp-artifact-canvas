{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "wmac/artifact",
    "version": "0.3.0",
    "title": "Artifact Canvas",
    "category": "text",
    "description": "Stores a complete HTML document and serves it as a passthrough canvas on the front end.",
    "textdomain": "webmultipliers-wp-artifact-canvas",
    "editorScript": "file:./editor.js",
    "editorStyle": "file:./editor.css",
    "attributes": {
        "html": {
            "type": "string",
            "default": ""
        },
        "fileStored": {
            "type": "boolean",
            "default": false
        }
    },
    "supports": {
        "html": false,
        "reusable": false,
        "lock": false
    }
}